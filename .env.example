# ==============================================================================
# RENVUE ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# All internal services (Postgres, Redis, Backend, Worker, Frontend) are
# automatically wired together in docker-compose.yml.
# You only need to supply your PayPal Sandbox credentials and an LLM API key!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYPAL DEVELOPER SANDBOX CREDENTIALS (Required for PayPal sync & webhooks)
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_BUSINESS_EMAIL=
PAYPAL_PERSONAL_EMAIL=
# Optional: Set webhook ID if already registered, or let the app register one
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------------------
# 2. AI / LLM PROVIDER SELECTION
# Choose one provider: groq (recommended, fast & free tier), gemini, mistral, openrouter, ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq (Free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama / Self-hosted
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# ------------------------------------------------------------------------------
# 3. OPTIONAL MESSAGING & VOICE CHANNELS
# (Leave empty if not testing live SMS/WhatsApp/Voice callbacks)
# ------------------------------------------------------------------------------
TWILO_ACCOUNT_SID=
TWILO_AUTH_TOKEN=
TWILO_WHATSAPP_NUMBER=
RESEND_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPTIONAL DEMO / POLICY OVERRIDES
# ------------------------------------------------------------------------------
# Set DEMO_MODE=true if testing without live PayPal sandbox calls
DEMO_MODE=false
MAX_DISCOUNT_ALLOWED=30
MIN_DISCOUNT_ALLOWED=5
