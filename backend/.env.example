# Renvue backend configuration. Copy to .env and fill in local values.
# Never commit real credentials.

# PayPal REST app (Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_IDS=
PAYPAL_BUSINESS_EMAIL=your-sandbox-business@example.com
PAYPAL_PERSONAL_EMAIL=your-sandbox-personal@example.com

# AI / LLM Provider Selection (choose whatever free provider you use: groq, gemini, mistral, openrouter, ollama, huggingface)
# The API boots without a key, but inbound AI replies need the selected provider's key below.
LLM_PROVIDER=groq
MODEL=

# Groq (Free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama / Local
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=beam:cloud
OLLAMA_API_KEY=

# Optional messaging providers
ELEVENLABS_API_KEY=
TWILO_ACCOUNT_SID=
TWILO_AUTH_TOKEN=
TWILO_WHATSAPP_NUMBER=
RESEND_API_KEY=

# Persistence and task queue
DATABASE_URL=postgresql://renvue:renvue@localhost:5432/renvue
REDIS_URL=redis://localhost:6379/0

# App URLs and policy
PYTHONPATH=src
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# true  = mock PayPal links and skip outbound email/WhatsApp (offline demo only).
# false = call the PayPal sandbox using the credentials above.
DEMO_MODE=false
CONTACT_WINDOW_START_HOUR=9
CONTACT_WINDOW_END_HOUR=21
MAX_DISCOUNT_ALLOWED=30
MIN_DISCOUNT_ALLOWED=5
MAX_GRACE_PERIOD=7

# Online learning (play-level empirical Bayes updates on observed outcomes)
LEARNING_ENABLED=true
LEARNING_PRIOR_STRENGTH=20
LEARNING_MIN_SAMPLES=5

# Nightly retraining (disabled by default; candidate-only, no auto-promotion)
RETRAIN_ENABLED=false
RETRAIN_HOUR_UTC=10
RETRAIN_MINUTE=0
RETRAIN_DRY_RUN=true
RETRAIN_MIN_SAMPLES=100
RETRAIN_MIN_RECOVERED=20
RETRAIN_MIN_PER_PLAY=5
RETRAIN_MIN_PLAYS=3
RETRAIN_MIN_DAYS=7

