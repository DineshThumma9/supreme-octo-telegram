# Renvue backend configuration. Copy to .env and fill in local values.
# Never commit real credentials.

# PayPal REST app (Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_IDS=
PAYPAL_EMAIL=your-sandbox-business@example.com

# AI / messaging providers (optional for local demo)
MISTRAL_API_KEY=
ELEVENLABS_API_KEY=
TWILO_ACCOUNT_SID=
TWILO_AUTH_TOKEN=
TWILO_WHATSAPP_NUMBER=
RESEND_API_KEY=
MODEL=mistral-small-latest

# Persistence and task queue
DATABASE_URL=postgresql://renvue:renvue@localhost:5432/renvue
REDIS_URL=redis://localhost:6379/0

# App URLs and policy
PYTHONPATH=src
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEMO_MODE=true
CONTACT_WINDOW_START_HOUR=9
CONTACT_WINDOW_END_HOUR=21
MAX_DISCOUNT_ALLOWED=30
MIN_DISCOUNT_ALLOWED=5
MAX_GRACE_PERIOD=7
